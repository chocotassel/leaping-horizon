{
  "name": "neon-slice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "mark:beats": "vite --host 0.0.0.0 --open /beat-marker.html",
    "lab:rhythm": "vite --host 0.0.0.0 --open /rhythm-lab.html",
    "lab:pattern": "vite --host 0.0.0.0 --open /pattern-lab.html",
    "setup:rhythm": "powershell -ExecutionPolicy Bypass -File scripts/setup-rhythm-env.ps1",
    "build": "tsc -b && vite build",
    "analyze:rhythm": "node scripts/generate-level.mjs",
    "build:rhythm-levels": "node scripts/build-rhythm-levels.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:level": "node scripts/level-check.mjs",
    "test:rhythm-feedback": ".\\.venv-analysis\\Scripts\\python.exe scripts/rhythm-feedback-check.py",
    "test:physics": "tsc src/game/physics.ts --ignoreConfig --target ES2020 --module ESNext --moduleResolution Bundler --outDir node_modules/.cache/leaping-horizon-physics-check --skipLibCheck && node scripts/physics-check.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "three": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "latest"
  }
}
